    "dev": "npm run generate-fs && vite",
    "build": "npm run generate-fs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages",
