    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.6.2",
    "react-tsparticles": "^2.12.2",
    "tsparticles-slim": "^2.12.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
